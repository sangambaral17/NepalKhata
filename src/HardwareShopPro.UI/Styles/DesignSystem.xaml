<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════
         DESIGN SYSTEM — ShopPro Premium Theme
         Apple meets Enterprise: clean, confident, breathable.
         ════════════════════════════════════════════════════════════ -->

    <!-- ─── Brand Colors (Theme-Independent) ───────────────────── -->
    <Color x:Key="PrimaryColor">#3B5BDB</Color>
    <Color x:Key="PrimaryLightColor">#748FFC</Color>
    <Color x:Key="PrimaryDarkColor">#2F4AC0</Color>
    <Color x:Key="AccentColor">#51CF66</Color>
    <Color x:Key="SuccessColor">#40C057</Color>
    <Color x:Key="WarningColor">#FF922B</Color>
    <Color x:Key="DangerColor">#FA5252</Color>
    <Color x:Key="InfoColor">#339AF0</Color>
    <Color x:Key="PurpleColor">#CC5DE8</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>

    <!-- Primary at various opacities -->
    <SolidColorBrush x:Key="PrimaryBrush08" Color="{StaticResource PrimaryColor}" Opacity="0.08"/>
    <SolidColorBrush x:Key="PrimaryBrush10" Color="{StaticResource PrimaryColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="PrimaryBrush15" Color="{StaticResource PrimaryColor}" Opacity="0.15"/>
    <SolidColorBrush x:Key="AccentBrush10" Color="{StaticResource AccentColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="WarningBrush10" Color="{StaticResource WarningColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="DangerBrush10" Color="{StaticResource DangerColor}" Opacity="0.10"/>
    <SolidColorBrush x:Key="PurpleBrush10" Color="{StaticResource PurpleColor}" Opacity="0.10"/>

    <!-- ─── Light Theme Colors (Default) ───────────────────────── -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212529"/>
    <!-- TextBrush is an alias for TextPrimaryBrush for convenience -->
    <SolidColorBrush x:Key="TextBrush" Color="#212529"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#868E96"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#EEF2FF"/>

    <!-- ─── Gradients ──────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B5BDB" Offset="0"/>
        <GradientStop Color="#5C7CFA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LoginPanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B5BDB" Offset="0"/>
        <GradientStop Color="#2F4AC0" Offset="1"/>
    </LinearGradientBrush>

    <!-- ─── Shadows (Light Theme) ──────────────────────────────── -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2"
                      Color="#000000" Opacity="0.06" Direction="270"/>
    <DropShadowEffect x:Key="ElevatedCardShadow" BlurRadius="24" ShadowDepth="4"
                      Color="#3B5BDB" Opacity="0.10" Direction="270"/>
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="8" ShadowDepth="2"
                      Color="#3B5BDB" Opacity="0.25" Direction="270"/>

    <!-- ─── Typography ─────────────────────────────────────────── -->
    <FontFamily x:Key="PrimaryFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonospaceFont">Cascadia Code, Consolas</FontFamily>

    <Style x:Key="H1Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="H2Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="H3Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="BodySmallText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonospaceFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ─── Spacing System (8px grid) ──────────────────────────── -->
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">16</Thickness>
    <Thickness x:Key="SpacingLG">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>
    <Thickness x:Key="SpacingXXL">48</Thickness>

    <!-- ─── Corner Radii ───────────────────────────────────────── -->
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <CornerRadius x:Key="ButtonRadius">10</CornerRadius>
    <CornerRadius x:Key="InputRadius">10</CornerRadius>
    <CornerRadius x:Key="BadgeRadius">6</CornerRadius>
    <CornerRadius x:Key="TooltipRadius">8</CornerRadius>
    <CornerRadius x:Key="PillRadius">50</CornerRadius>

</ResourceDictionary>
