<Application x:Class="HardwareShopPro.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareShopPro.UI.ViewModels"
             xmlns:views="clr-namespace:HardwareShopPro.UI.Views">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- DataTemplate mapping: ViewModel → View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductListViewModel}">
                <views:ProductListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SupplierListViewModel}">
                <views:SupplierListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerListViewModel}">
                <views:CustomerListView />
            </DataTemplate>

            <!-- Global Styles -->
            <Style x:Key="StatCard" TargetType="materialDesign:Card">
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="UniformCornerRadius" Value="12" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
