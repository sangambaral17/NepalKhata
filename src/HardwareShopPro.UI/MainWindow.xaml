<Window x:Class="HardwareShopPro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="HardwareShopPro — Hardware Shop Management"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Sidebar ═══ -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- App Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Devices" Width="32" Height="32"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                VerticalAlignment="Center"/>
                            <TextBlock Text="HardwareShopPro" FontSize="18" FontWeight="Bold"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Separator Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- User Info (Bottom) -->
                    <Border DockPanel.Dock="Bottom" Padding="16,12"
                            Background="{DynamicResource MaterialDesign.Brush.Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AccountCircle" Width="32" Height="32"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding CurrentUser.Role}" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Logout" Command="{Binding LogoutCommand}">
                                <materialDesign:PackIcon Kind="Logout" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Navigation Menu -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,0">
                            <!-- Dashboard -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48"
                                    HorizontalAlignment="Stretch" Margin="0,2"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboard" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Products -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48"
                                    HorizontalAlignment="Stretch" Margin="0,2"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Products">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Package" VerticalAlignment="Center"/>
                                    <TextBlock Text="Products" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Suppliers -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48"
                                    HorizontalAlignment="Stretch" Margin="0,2"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Suppliers">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TruckDelivery" VerticalAlignment="Center"/>
                                    <TextBlock Text="Suppliers" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- Customers -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48"
                                    HorizontalAlignment="Stretch" Margin="0,2"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Customers">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountGroup" VerticalAlignment="Center"/>
                                    <TextBlock Text="Customers" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="8,12"/>

                            <!-- Theme Toggle -->
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48"
                                    HorizontalAlignment="Stretch" Margin="0,2"
                                    Command="{Binding ToggleThemeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ThemeLightDark" VerticalAlignment="Center"/>
                                    <TextBlock Text="Toggle Theme" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══ Main Content Area ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0" Padding="24,16"
                        Background="{DynamicResource MaterialDesign.Brush.Background}">
                    <Grid>
                        <TextBlock Text="{Binding CurrentViewTitle}" FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="DateDisplay"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6"/>
                    </Grid>
                </Border>

                <!-- Page Content (bound to CurrentView) -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                                Margin="16,0,16,16"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
