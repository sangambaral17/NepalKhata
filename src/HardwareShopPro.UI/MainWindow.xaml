<Window x:Class="HardwareShopPro.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ShopPro — Hardware Management"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFont}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ SIDEBAR ═══ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- ── Logo Area (72px) ── -->
                    <Border DockPanel.Dock="Top" Height="72" Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource PrimaryBrush}">
                                <materialDesign:PackIcon Kind="Devices" Width="20" Height="20"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ShopPro" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Hardware Management" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── User Profile (Bottom) ── -->
                    <Border DockPanel.Dock="Bottom" Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar Circle -->
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{DynamicResource PrimaryBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AD" Foreground="White"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.DisplayName}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <!-- Role Badge -->
                                <Border Style="{StaticResource RoleBadge}" HorizontalAlignment="Left"
                                        Margin="0,2,0,0">
                                    <TextBlock Text="{Binding CurrentUser.Role}"
                                               FontSize="10" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource PremiumIconButton}"
                                    ToolTip="Logout" Command="{Binding LogoutCommand}"
                                    Width="32" Height="32">
                                <materialDesign:PackIcon Kind="Logout" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── Navigation Menu ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,0">

                            <!-- GROUP: MAIN -->
                            <TextBlock Text="MAIN" Style="{StaticResource NavGroupLabel}"/>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Dashboard" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Products">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Inventory" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Billing">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Receipt" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Billing" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Customers">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Customers" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- GROUP: MANAGEMENT -->
                            <TextBlock Text="MANAGEMENT" Style="{StaticResource NavGroupLabel}"/>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Suppliers">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TruckDelivery" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Suppliers" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Reports">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Reports" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="AI">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Robot" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="AI Assistant" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <!-- GROUP: SYSTEM -->
                            <TextBlock Text="SYSTEM" Style="{StaticResource NavGroupLabel}"/>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{DynamicResource NavButton}"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Help">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HelpCircle" Width="20" Height="20"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Help" Margin="12,0,0,0"
                                               VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- ═══ MAIN CONTENT AREA ═══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Top Bar (64px) ── -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid>
                        <!-- Left: Title + Breadcrumb -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentViewTitle}"
                                       Style="{StaticResource H1Text}"/>
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0">
                                <Run Text="Home"/>
                                <Run Text=" › "/>
                                <Run Text="{Binding CurrentViewTitle, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Right: Date + Theme Toggle -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Theme Toggle -->
                            <Button Style="{StaticResource PremiumIconButton}"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="Toggle Theme" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="ThemeLightDark" Width="20" Height="20"/>
                            </Button>

                            <!-- Date -->
                            <TextBlock x:Name="DateDisplay"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Page Content ── -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                                Margin="24,16,24,24"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
