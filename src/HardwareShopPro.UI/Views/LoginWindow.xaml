<Window x:Class="HardwareShopPro.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="HardwareShopPro — Login"
        Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="16" Background="{DynamicResource MaterialDesign.Brush.Background}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource MaterialDesignIconButton}"
                    Click="CloseButton_Click" Margin="0,-10,-10,0">
                <materialDesign:PackIcon Kind="Close" />
            </Button>

            <!-- Logo -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,30">
                <materialDesign:PackIcon Kind="Devices" Width="64" Height="64"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    HorizontalAlignment="Center"/>
                <TextBlock Text="HardwareShopPro" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                <TextBlock Text="Hardware Shop Management System"
                           FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Username -->
            <TextBox Grid.Row="2"
                     materialDesign:HintAssist.Hint="Username"
                     materialDesign:HintAssist.IsFloating="True"
                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                     materialDesign:TextFieldAssist.LeadingIcon="Account"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"
                     FontSize="14"/>

            <!-- Password -->
            <PasswordBox Grid.Row="3" x:Name="PasswordBox"
                         materialDesign:HintAssist.Hint="Password"
                         materialDesign:HintAssist.IsFloating="True"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Lock"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,16"
                         FontSize="14"
                         KeyDown="PasswordBox_KeyDown"/>

            <!-- Error Message -->
            <TextBlock Grid.Row="4" Text="{Binding LoginError}"
                       Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                       FontSize="12" TextWrapping="Wrap"
                       Visibility="{Binding LoginError, Converter={StaticResource NullableToVisibilityConverter}}"
                       Margin="0,0,0,16"/>

            <!-- Login Button -->
            <Button Grid.Row="5" Content="LOGIN" FontSize="14" Height="44"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvertBooleanConverter}}"
                    Click="LoginButton_Click"
                    HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

            <!-- Loading -->
            <ProgressBar Grid.Row="6"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoggingIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Margin="0,8"/>

            <!-- Footer -->
            <TextBlock Grid.Row="7" Text="Default: admin / admin123"
                       FontSize="11" Opacity="0.4"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</Window>
