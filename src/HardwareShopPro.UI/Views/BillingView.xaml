<UserControl x:Class="HardwareShopPro.UI.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:HardwareShopPro.Core.Models;assembly=HardwareShopPro.Core"
             xmlns:vm="clr-namespace:HardwareShopPro.UI.ViewModels">

    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="F9" Command="{Binding GenerateInvoiceCommand}"/>
        <KeyBinding Key="Esc" Command="{Binding ClearCartCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL: Product Search & Cart ═══ -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Search Bar -->
            <Border Grid.Row="0" Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PremiumSearchBox}"
                             Tag="Search by name, SKU, barcode (F2)..."
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Start typing product name or SKU..."
                             TextChanged="SearchBox_TextChanged"/>

                    <!-- Search Results Dropdown -->
                    <Border Grid.Row="1"
                            Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="0,0,8,8" MaxHeight="280" Effect="{DynamicResource CardShadow}">
                        <ListBox ItemsSource="{Binding SearchResults}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding SKU}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SellingPrice, StringFormat='NPR {0:N0}'}"
                                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Cart Table -->
            <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Padding="4" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding CartItems}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                              RowHeight="52" HeadersVisibility="Column"
                              FontFamily="{StaticResource PrimaryFont}">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="14,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="90"/>

                            <!-- Quantity Stepper -->
                            <DataGridTemplateColumn Header="QTY" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="4"
                                                    Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Minus" Width="12" Height="12"/>
                                            </Button>
                                            <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold" MinWidth="20" TextAlignment="Center"/>
                                            <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="4"
                                                    Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Plus" Width="12" Height="12"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="PRICE" Binding="{Binding UnitPrice, StringFormat=N2}" Width="80"/>

                            <!-- Discount Input -->
                            <DataGridTemplateColumn Header="DISC %" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                                                 VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal, StringFormat=N2}" Width="80" FontWeight="Bold"/>

                            <!-- Remove Action -->
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove Item">
                                            <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty Cart Message -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,24"
                                Visibility="{Binding CartItems.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Customer Section -->
            <Border Grid.Row="2" Style="{StaticResource PremiumCard}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Customer Details" Style="{StaticResource H3Text}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource PremiumSearchBox}"
                                     materialDesign:HintAssist.Hint="Search customer by name or phone..."
                                     Text="{Binding CustomerSearchQuery, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCustomersCommand}"
                                                CommandParameter="{Binding CustomerSearchQuery}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Content="Search"
                                    Command="{Binding SearchCustomersCommand}"
                                    CommandParameter="{Binding CustomerSearchQuery}"/>
                        </Grid>

                        <!-- Customer Results -->
                        <ListBox ItemsSource="{Binding CustomerResults}" Margin="0,4,0,0"
                                 Visibility="{Binding HasCustomerResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Background="{DynamicResource Surface2Brush}" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected Customer Badge -->
                        <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="8"
                                Background="{DynamicResource PrimaryBrush08}"
                                Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedCustomer.Name}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedCustomer.Phone}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding SelectCustomerCommand}" CommandParameter="{x:Null}"
                                        ToolTip="Remove customer">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ RIGHT PANEL: Order Summary ═══ -->
        <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Padding="24" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="Order Summary" Style="{StaticResource H2Text}"/>
                    <TextBlock Text="{Binding InvoiceNumber}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,24"/>

                    <!-- Payment Breakdown -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Subtotal"/>
                        <TextBlock Text="{Binding SubTotal, StringFormat=NPR {0:N2}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Discount" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding TotalDiscount, StringFormat=- NPR {0:N2}}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <!-- VAT Toggle -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsVatEnabled}" Margin="0,0,8,0"/>
                            <TextBlock Text="Include VAT (13%)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,24"
                          Visibility="{Binding IsVatEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="VAT (13%)"/>
                        <TextBlock Text="{Binding TotalTax, StringFormat=NPR {0:N2}}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,24"/>

                    <Grid Margin="0,0,0,32">
                        <TextBlock Text="Grand Total" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat=NPR {0:N2}}" HorizontalAlignment="Right"
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                    </Grid>

                    <!-- Payment Mode -->
                    <TextBlock Text="Payment Mode" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                    <UniformGrid Rows="1" Margin="0,0,0,24">
                        <Button Content="💵 Cash" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                                Command="{Binding SetPaymentModeCommand}" CommandParameter="Cash"/>
                        <Button Content="💳 Card" Style="{StaticResource SecondaryButton}" Margin="4,0,4,0"
                                Command="{Binding SetPaymentModeCommand}" CommandParameter="Card"/>
                        <Button Content="📱 UPI" Style="{StaticResource SecondaryButton}" Margin="4,0,4,0"
                                Command="{Binding SetPaymentModeCommand}" CommandParameter="UPI"/>
                        <Button Content="📋 Credit" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0"
                                Command="{Binding SetPaymentModeCommand}" CommandParameter="Credit"/>
                    </UniformGrid>

                    <!-- Cash Calculator -->
                    <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox materialDesign:HintAssist.Hint="Amount Received (NPR)"
                                 Text="{Binding AmountReceived, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="Change to Return" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChangeAmount, StringFormat=NPR {0:N2}}"
                                       HorizontalAlignment="Right" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Error Message -->
                    <Border Padding="12,8" CornerRadius="8" Background="{DynamicResource DangerBrush10}" Margin="0,0,0,16"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action Buttons -->
                    <Button Content="🧾 Generate Invoice (F9)" Command="{Binding GenerateInvoiceCommand}"
                            Style="{StaticResource PrimaryButton}" Height="48" Margin="0,0,0,12"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InvertBooleanConverter}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save Draft" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Content="🗑 Clear Cart (Esc)" Command="{Binding ClearCartCommand}"
                                Style="{StaticResource DangerButton}" Margin="6,0,0,0"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ POST-INVOICE SUCCESS DIALOG OVERLAY ═══ -->
        <Border Grid.ColumnSpan="2"
                Visibility="{Binding IsInvoiceSuccessOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#AA000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="16" Padding="40,32" Width="440"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <!-- Success Icon -->
                    <TextBlock Text="✅" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Invoice Generated!" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding LastInvoiceNumber}" FontSize="14"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding LastGrandTotal, StringFormat='NPR {0:N2}'}" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Action Buttons -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Button Command="{Binding PrintInvoiceCommand}" Margin="0,0,6,0"
                                Style="{StaticResource PrimaryButton}" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenInvoicePdfCommand}" Margin="3,0,3,0"
                                Style="{StaticResource SecondaryButton}" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShareWhatsAppCommand}" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButton}" Height="44"
                                Background="#25D366" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Whatsapp" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="WhatsApp" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Close -->
                    <Button Content="Done" Command="{Binding CloseInvoiceSuccessCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="36" Width="120"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>

</UserControl>
