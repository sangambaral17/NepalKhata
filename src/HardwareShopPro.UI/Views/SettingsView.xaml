<UserControl x:Class="HardwareShopPro.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HardwareShopPro.UI.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL: Navigation ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,24,0,0">
                <TextBlock Text="Settings" Style="{StaticResource H2Text}" Margin="24,0,0,16"/>
                
                <ListBox x:Name="SettingsNavList" SelectedIndex="0" Padding="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Height" Value="48"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryLightBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountMultiple" Margin="0,0,12,0"/>
                            <TextBlock Text="User Management"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Domain" Margin="0,0,12,0"/>
                            <TextBlock Text="Business Profile"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Palette" Margin="0,0,12,0"/>
                            <TextBlock Text="Appearance"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Robot" Margin="0,0,12,0"/>
                            <TextBlock Text="AI Configuration"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BackupRestore" Margin="0,0,12,0"/>
                            <TextBlock Text="Backup &amp; Data"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Information" Margin="0,0,12,0"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ═══ RIGHT PANEL: Content ═══ -->
        <Border Grid.Column="1" Padding="32">
            <Grid>
                <!-- 0: USER MANAGEMENT -->
                <Grid Visibility="{Binding SelectedIndex, ElementName=SettingsNavList, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Margin="0,0,0,24">
                        <TextBlock Text="User Management" Style="{StaticResource H2Text}"/>
                        <Button Content="Add User" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAddUserDialogCommand}"/>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                                  RowHeight="52" HeadersVisibility="All">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="DISPLAY NAME" Binding="{Binding DisplayName}" Width="*"/>
                                
                                <DataGridTemplateColumn Header="ROLE" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                    Background="{DynamicResource Surface2Brush}">
                                                <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="STATUS" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="Green"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Kind="CloseCircle" Foreground="Red">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="ACTIONS" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Toggle Active"
                                                        Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Power"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Reset Password"
                                                        Command="{Binding DataContext.OpenResetPasswordDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="LockReset"/>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Delete"
                                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Delete" Foreground="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Add User Dialog -->
                    <materialDesign:DialogHost IsOpen="{Binding IsAddUserDialogOpen}" Grid.RowSpan="2">
                        <materialDesign:DialogHost.DialogContent>
                            <Border Width="380" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="Add New User" Style="{StaticResource H3Text}" Margin="0,0,0,16"/>
                                    
                                    <TextBox materialDesign:HintAssist.Hint="Username *" Style="{StaticResource PremiumInput}" 
                                             Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                    <TextBox materialDesign:HintAssist.Hint="Display Name" Style="{StaticResource PremiumInput}" 
                                             Text="{Binding NewUserDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>
                                    <PasswordBox materialDesign:HintAssist.Hint="Password *" Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                                 Margin="0,0,0,16"/>
                                    
                                    <ComboBox materialDesign:HintAssist.Hint="Role" Margin="0,0,0,8"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              SelectedIndex="{Binding NewUserRoleIndex}">
                                        <ComboBoxItem Content="Cashier"/>
                                        <ComboBoxItem Content="Manager"/>
                                        <ComboBoxItem Content="Admin"/>
                                    </ComboBox>

                                    <!-- Error message -->
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" Margin="0,0,0,16"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                                Command="{Binding CloseAddUserDialogCommand}"/>
                                        <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                                Command="{Binding AddUserCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </materialDesign:DialogHost.DialogContent>
                    </materialDesign:DialogHost>

                    <!-- Reset Password Dialog -->
                    <materialDesign:DialogHost IsOpen="{Binding IsResetPasswordDialogOpen}" Grid.RowSpan="2">
                        <materialDesign:DialogHost.DialogContent>
                            <Border Width="350" Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3Text}" Margin="0,0,0,8">
                                        <Run Text="Reset Password for "/>
                                        <Run Text="{Binding ResetPasswordUser.Username, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                    
                                    <PasswordBox materialDesign:HintAssist.Hint="New Password (min 6 chars)" 
                                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                                 Margin="0,0,0,16"/>

                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" Margin="0,0,0,16"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                                Command="{Binding CloseResetPasswordDialogCommand}"/>
                                        <Button Grid.Column="1" Content="Reset" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                                Command="{Binding ResetPasswordCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </materialDesign:DialogHost.DialogContent>
                    </materialDesign:DialogHost>
                </Grid>

                <!-- 1: BUSINESS PROFILE -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedIndex, ElementName=SettingsNavList, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Business Profile" Style="{StaticResource H2Text}" Margin="0,0,0,24"/>
                        
                        <!-- Logo Section -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Business Logo" Style="{StaticResource H3Text}" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="80" Height="80" CornerRadius="8" Background="{DynamicResource Surface2Brush}" 
                                            Margin="0,0,16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <materialDesign:PackIcon Kind="StorefrontOutline" Width="40" Height="40" 
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="Upload Logo" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding BrowseLogoCommand}" Margin="0,0,0,4"/>
                                        <TextBlock Text="PNG, JPG up to 1MB" FontSize="11" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Form Fields -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Store Information" Style="{StaticResource H3Text}" Margin="0,0,0,16"/>
                                <TextBox materialDesign:HintAssist.Hint="Store Name *" Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource PremiumInput}" Margin="0,0,0,16"/>
                                <TextBox materialDesign:HintAssist.Hint="Address" Text="{Binding BusinessAddress, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource PremiumInput}" Margin="0,0,0,16"/>
                                <TextBox materialDesign:HintAssist.Hint="Phone" Text="{Binding BusinessPhone, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource PremiumInput}" Margin="0,0,0,16"/>
                                <TextBox materialDesign:HintAssist.Hint="Email" Text="{Binding BusinessEmail, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource PremiumInput}" Margin="0,0,0,16"/>
                                <TextBox materialDesign:HintAssist.Hint="GST/PAN Number" Text="{Binding GstNumber, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource PremiumInput}" Margin="0,0,0,16"/>
                                
                                <!-- Status message -->
                                <TextBlock Text="{Binding BusinessProfileStatus}" FontSize="12" Margin="0,0,0,8"
                                           Foreground="Red" TextWrapping="Wrap"/>
                                
                                <Button Content="Save Changes" Command="{Binding SaveBusinessProfileCommand}" 
                                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2: APPEARANCE -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedIndex, ElementName=SettingsNavList, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Appearance" Style="{StaticResource H2Text}" Margin="0,0,0,24"/>
                        
                        <!-- Theme Toggle -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Dark Mode" Style="{StaticResource H3Text}"/>
                                    <TextBlock Text="Switch between light and dark theme" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                              IsChecked="{Binding IsDarkTheme}"
                                              Command="{Binding ToggleThemeCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Accent Color -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Accent Color" Style="{StaticResource H3Text}" Margin="0,0,0,4"/>
                                <TextBlock Text="Choose your primary interface color" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Indigo -->
                                    <Button Width="40" Height="40" Margin="0,0,12,0" Cursor="Hand"
                                            Command="{Binding SetAccentColorCommand}" CommandParameter="0"
                                            ToolTip="Indigo">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="20" Background="#4F46E5" Width="40" Height="40"
                                                        BorderBrush="White" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Blue -->
                                    <Button Width="40" Height="40" Margin="0,0,12,0" Cursor="Hand"
                                            Command="{Binding SetAccentColorCommand}" CommandParameter="1"
                                            ToolTip="Blue">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="20" Background="#2563EB" Width="40" Height="40"
                                                        BorderBrush="White" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Purple -->
                                    <Button Width="40" Height="40" Margin="0,0,12,0" Cursor="Hand"
                                            Command="{Binding SetAccentColorCommand}" CommandParameter="2"
                                            ToolTip="Purple">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="20" Background="#7C3AED" Width="40" Height="40"
                                                        BorderBrush="White" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Teal -->
                                    <Button Width="40" Height="40" Margin="0,0,12,0" Cursor="Hand"
                                            Command="{Binding SetAccentColorCommand}" CommandParameter="3"
                                            ToolTip="Teal">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="20" Background="#0D9488" Width="40" Height="40"
                                                        BorderBrush="White" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Rose -->
                                    <Button Width="40" Height="40" Margin="0,0,12,0" Cursor="Hand"
                                            Command="{Binding SetAccentColorCommand}" CommandParameter="4"
                                            ToolTip="Rose">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="20" Background="#E11D48" Width="40" Height="40"
                                                        BorderBrush="White" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Amber -->
                                    <Button Width="40" Height="40" Cursor="Hand"
                                            Command="{Binding SetAccentColorCommand}" CommandParameter="5"
                                            ToolTip="Amber">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Border CornerRadius="20" Background="#D97706" Width="40" Height="40"
                                                        BorderBrush="White" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Font Size -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24">
                            <StackPanel>
                                <TextBlock Text="Font Size" Style="{StaticResource H3Text}" Margin="0,0,0,4"/>
                                <TextBlock Text="Adjust the text size across the application" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Small" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" MinWidth="80"
                                            Command="{Binding SetFontSizeCommand}" CommandParameter="0.85"/>
                                    <Button Content="Normal" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="80"
                                            Command="{Binding SetFontSizeCommand}" CommandParameter="1.0"/>
                                    <Button Content="Large" Style="{StaticResource SecondaryButton}" MinWidth="80"
                                            Command="{Binding SetFontSizeCommand}" CommandParameter="1.15"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3: AI CONFIG -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedIndex, ElementName=SettingsNavList, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=3}">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="AI Configuration" Style="{StaticResource H2Text}" Margin="0,0,0,24"/>
                        
                        <Border Style="{StaticResource PremiumCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Claude API Key" Style="{StaticResource H3Text}" Margin="0,0,0,4"/>
                                <TextBlock Text="Required for AI-powered features. Your key is encrypted using Windows DPAPI." 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox materialDesign:HintAssist.Hint="sk-ant-api03-..." 
                                             Text="{Binding ClaudeApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource PremiumInput}"/>
                                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}" Margin="8,0,0,0"
                                            Command="{Binding ToggleShowApiKeyCommand}" ToolTip="Show/Hide Key">
                                        <materialDesign:PackIcon Kind="Eye"/>
                                    </Button>
                                </Grid>
                                
                                <CheckBox Content="Enable AI Features" IsChecked="{Binding IsAIEnabled}" Margin="0,0,0,16"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="Save Key" Command="{Binding SaveApiKeyCommand}" 
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                                    <Button Content="Test Connection" Command="{Binding TestAiConnectionCommand}" 
                                            Style="{StaticResource SecondaryButton}" 
                                            IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InvertBooleanConverter}}"/>
                                </StackPanel>
                                
                                <!-- Connection Status -->
                                <Border CornerRadius="8" Padding="12" Background="{DynamicResource Surface2Brush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="Green" Margin="0,0,8,0"
                                                                  Visibility="{Binding IsAiConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding AiConnectionStatus}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        
                        <!-- No API Key Notice -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24" Background="#FFF3E0" CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#E65100" Width="24" Height="24" Margin="0,0,12,0"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#E65100">
                                    <Run FontWeight="SemiBold" Text="AI features require an API key."/>
                                    <LineBreak/>
                                    <Run Text="Get your key from console.anthropic.com"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4: BACKUP -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedIndex, ElementName=SettingsNavList, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=4}">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Backup &amp; Data" Style="{StaticResource H2Text}" Margin="0,0,0,24"/>
                        
                        <!-- Backup Section -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Database Backup" Style="{StaticResource H3Text}" Margin="0,0,0,16"/>
                                
                                <TextBlock Text="Backup Location" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BackupPath}" Style="{StaticResource PremiumInput}" IsReadOnly="True" Margin="0,0,0,16"/>
                                
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" FontSize="13">
                                    <Run Text="Last Backup: "/>
                                    <Run Text="{Binding LastBackupDate, StringFormat={}{0:g}, FallbackValue=Never}"/>
                                </TextBlock>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="Backup Now" Command="{Binding BackupNowCommand}" 
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                                    <Button Content="Restore from Backup" Command="{Binding RestoreBackupCommand}" 
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding BackupStatus}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Auto Backup -->
                        <Border Style="{StaticResource PremiumCard}" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Auto Backup" Style="{StaticResource H3Text}"/>
                                    <TextBlock Text="Automatically create a backup every 24 hours" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                              IsChecked="{Binding AutoBackupEnabled}"
                                              Command="{Binding ToggleAutoBackupCommand}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5: ABOUT -->
                <Grid Visibility="{Binding SelectedIndex, ElementName=SettingsNavList, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=5}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="StorefrontOutline" Width="64" Height="64" 
                                                  Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="NepalKhata" Style="{StaticResource H1Text}" HorizontalAlignment="Center"/>
                        <TextBlock Text="ShopProNepal — Retail Management Software" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="Version 2.0.0 — Sprint 2" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock Text="Built with ♥ for Hardware Shops in Nepal" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        
                        <Border Style="{StaticResource PremiumCard}" Padding="24" MaxWidth="400">
                            <StackPanel>
                                <TextBlock Text="Technology Stack" Style="{StaticResource H3Text}" Margin="0,0,0,12"/>
                                <TextBlock Text="• .NET 8.0 + WPF" Margin="0,0,0,4"/>
                                <TextBlock Text="• Material Design in XAML" Margin="0,0,0,4"/>
                                <TextBlock Text="• SQLite + Dapper" Margin="0,0,0,4"/>
                                <TextBlock Text="• PdfSharpCore for PDF" Margin="0,0,0,4"/>
                                <TextBlock Text="• Claude AI Integration" Margin="0,0,0,4"/>
                                <TextBlock Text="• LiveCharts for Reports"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ═══ Toast Notification ═══ -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        CornerRadius="8" Padding="16,10" Background="#323232"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="13"/>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
