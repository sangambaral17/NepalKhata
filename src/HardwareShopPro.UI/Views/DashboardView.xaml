<UserControl x:Class="HardwareShopPro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
            <!-- Stat Cards Row -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                <!-- Total Products -->
                <materialDesign:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Package" Width="28" Height="28"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <TextBlock Text="Total Products" FontSize="14" Opacity="0.7"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalProducts}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Low Stock -->
                <materialDesign:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="28" Height="28" Foreground="Orange"/>
                            <TextBlock Text="Low Stock" FontSize="14" Opacity="0.7"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LowStockCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="Orange" Margin="0,8,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Today's Sales -->
                <materialDesign:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CartCheck" Width="28" Height="28" Foreground="LimeGreen"/>
                            <TextBlock Text="Today's Sales" FontSize="14" Opacity="0.7"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodaySalesCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="LimeGreen" Margin="0,8,0,0"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Today's Revenue -->
                <materialDesign:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="28" Height="28" Foreground="CornflowerBlue"/>
                            <TextBlock Text="Today's Revenue" FontSize="14" Opacity="0.7"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayRevenue, StringFormat='Rs. {0:N0}'}" FontSize="36" FontWeight="Bold"
                                   Foreground="CornflowerBlue" Margin="0,8,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Second Row: Monthly Revenue + Customers + Suppliers -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
                <materialDesign:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Monthly Revenue" FontSize="13" Opacity="0.7"/>
                        <TextBlock Text="{Binding MonthlyRevenue, StringFormat='Rs. {0:N0}'}"
                                   FontSize="28" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total Customers" FontSize="13" Opacity="0.7"/>
                        <TextBlock Text="{Binding TotalCustomers}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total Suppliers" FontSize="13" Opacity="0.7"/>
                        <TextBlock Text="{Binding TotalSuppliers}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Low Stock Alerts -->
            <materialDesign:Card Padding="20" Margin="8" UniformCornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Alert" Width="24" Height="24" Foreground="Orange" VerticalAlignment="Center"/>
                        <TextBlock Text="Low Stock Alerts" FontSize="16" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="Refresh" Margin="20,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RefreshCommand}" Height="30" FontSize="11"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding LowStockProducts}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              MaxHeight="250"
                              materialDesign:DataGridAssist.CellPadding="12,6"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                            <DataGridTextColumn Header="Min Level" Binding="{Binding MinStockLevel}" Width="80"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No low stock items — inventory is healthy! ✅"
                               Margin="0,12" FontSize="13" Opacity="0.6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LowStockCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
