<UserControl x:Class="HardwareShopPro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel>

            <!-- ═══ STAT CARDS ROW ═══ -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,24">

                <!-- Total Products — Indigo -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Icon + Label -->
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="{DynamicResource PrimaryBrush10}">
                                <materialDesign:PackIcon Kind="Package" Width="22" Height="22"
                                                         Foreground="{DynamicResource PrimaryBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Value + Label -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TotalProducts}" FontSize="28" FontWeight="Bold"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Total Products" FontSize="13"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Today's Sales — Green -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="{DynamicResource AccentBrush10}">
                                <materialDesign:PackIcon Kind="CartCheck" Width="22" Height="22"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TodaySalesCount}" FontSize="28" FontWeight="Bold"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Today's Sales" FontSize="13"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Low Stock — Orange/Warning -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="{DynamicResource WarningBrush10}">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="22" Height="22"
                                                         Foreground="{DynamicResource WarningBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding LowStockCount}" FontSize="28" FontWeight="Bold"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="Low Stock Items" FontSize="13"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Revenue — Purple -->
                <Border Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="{DynamicResource PurpleBrush10}">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="22" Height="22"
                                                         Foreground="{DynamicResource PurpleBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TodayRevenue, StringFormat='Rs. {0:N0}'}" FontSize="28" FontWeight="Bold"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Today's Revenue" FontSize="13"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ═══ SECOND ROW: Monthly Revenue + Customers + Suppliers ═══ -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,24">
                <Border Style="{StaticResource StatCard}" Height="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Monthly Revenue" FontSize="13"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding MonthlyRevenue, StringFormat='Rs. {0:N0}'}"
                                   FontSize="24" FontWeight="Bold" Margin="0,4,0,0"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Height="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Total Customers" FontSize="13"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCustomers}"
                                   FontSize="24" FontWeight="Bold" Margin="0,4,0,0"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Height="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Total Suppliers" FontSize="13"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalSuppliers}"
                                   FontSize="24" FontWeight="Bold" Margin="0,4,0,0"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ LOW STOCK ALERTS ═══ -->
            <Border Style="{StaticResource PremiumCard}" Padding="24">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{DynamicResource WarningBrush10}">
                                <materialDesign:PackIcon Kind="Alert" Width="18" Height="18"
                                                         Foreground="{DynamicResource WarningBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Low Stock Alerts" Style="{StaticResource H2Text}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Refresh" HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}"
                                Height="32" FontSize="12" Padding="12,0"/>
                    </Grid>

                    <!-- Data Grid -->
                    <DataGrid ItemsSource="{Binding LowStockProducts}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              MaxHeight="280"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              RowHeight="52"
                              FontFamily="{StaticResource PrimaryFont}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              materialDesign:DataGridAssist.CellPadding="14,8"
                              HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="14,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="STOCK" Binding="{Binding Stock}" Width="80"/>
                            <DataGridTextColumn Header="MIN LEVEL" Binding="{Binding MinStockLevel}" Width="80"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource MonospaceFont}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State -->
                    <TextBlock Text="No low stock items — inventory is healthy! ✅"
                               Margin="0,12" FontSize="13"
                               FontFamily="{StaticResource PrimaryFont}"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LowStockCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
