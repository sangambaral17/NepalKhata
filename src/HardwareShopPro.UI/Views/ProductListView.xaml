<UserControl x:Class="HardwareShopPro.UI.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12" UniformCornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="Search products (name, brand, SKU, category)..."
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Height="40" Margin="0,0,8,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <ToggleButton Grid.Column="1" ToolTip="AI Smart Search"
                                  IsChecked="{Binding IsAISearchEnabled}"
                                  Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                  Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Robot" Width="20" Height="20"/>
                    </ToggleButton>

                    <Button Grid.Column="2" Command="{Binding SearchCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40" Content="Search"/>
                </Grid>

                <!-- Category Filter -->
                <ComboBox Grid.Column="1" Width="150" Margin="12,0"
                          materialDesign:HintAssist.Hint="Category"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          FontSize="13" Height="40">
                    <ComboBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding FilterByCategoryCommand}"/>
                    </ComboBox.InputBindings>
                </ComboBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding OpenAddDialogCommand}"
                            ToolTip="Add Product (Ctrl+N)" Height="40" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                            <TextBlock Text="Add" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding OpenEditDialogCommand}"
                            ToolTip="Edit Selected" Height="40" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Pencil"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding DeleteProductCommand}"
                            Foreground="IndianRed"
                            ToolTip="Delete Selected" Height="40" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="Delete"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding ClearFiltersCommand}"
                            ToolTip="Clear Filters" Height="40">
                        <materialDesign:PackIcon Kind="FilterOff"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- AI Status -->
        <TextBlock Grid.Row="0" Text="{Binding AiSearchStatus}"
                   FontSize="11" Margin="20,56,0,0" Opacity="0.7"
                   Visibility="{Binding AiSearchStatus, Converter={StaticResource NullableToVisibilityConverter}}"/>

        <!-- ═══ Data Grid ═══ -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="12" Padding="4">
            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single"
                      materialDesign:DataGridAssist.CellPadding="14,8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="14,8"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="120"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="130"/>
                    <DataGridTextColumn Header="Buy Price" Width="100">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PurchasePrice" StringFormat="Rs. {0:N0}"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Sell Price" Width="100">
                        <DataGridTextColumn.Binding>
                            <Binding Path="SellingPrice" StringFormat="Rs. {0:N0}"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="70"/>
                    <DataGridTextColumn Header="Margin" Width="80">
                        <DataGridTextColumn.Binding>
                            <Binding Path="ProfitMargin" StringFormat="{}{0}%"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- ═══ Add/Edit Dialog ═══ -->
        <materialDesign:Card Grid.Row="0" Grid.RowSpan="2"
                             Visibility="{Binding IsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Panel.ZIndex="10"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Width="500" Padding="24" UniformCornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Add Product"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Text" Value="Edit Product"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBox materialDesign:HintAssist.Hint="Product Name *"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding EditingProduct.Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Category"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditingProduct.Category}" Margin="0,0,6,12"/>
                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Brand"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditingProduct.Brand}" Margin="6,0,0,12"/>
                </Grid>

                <TextBox materialDesign:HintAssist.Hint="SKU"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding EditingProduct.SKU}" Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Purchase Price"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditingProduct.PurchasePrice}" Margin="0,0,6,12"/>
                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Selling Price"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditingProduct.SellingPrice}" Margin="6,0,0,12"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Stock"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditingProduct.Stock}" Margin="0,0,6,12"/>
                    <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Min Stock Level"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding EditingProduct.MinStockLevel}" Margin="6,0,0,12"/>
                </Grid>

                <ComboBox materialDesign:HintAssist.Hint="Supplier"
                          materialDesign:HintAssist.IsFloating="True"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          ItemsSource="{Binding Suppliers}"
                          SelectedValuePath="Id"
                          DisplayMemberPath="Name"
                          SelectedValue="{Binding EditingProduct.SupplierId}"
                          Margin="0,0,0,12"/>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}"
                           Margin="0,0,0,12" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullableToVisibilityConverter}}"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Margin="0,0,8,0" Height="36"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding CancelDialogCommand}"/>
                    <Button Content="Save" Height="36"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveProductCommand}"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Loading Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000" Panel.ZIndex="20">
            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="60" Height="60"/>
        </Grid>
    </Grid>
</UserControl>
